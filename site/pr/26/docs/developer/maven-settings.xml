<?xml version="1.0" encoding="UTF-8"?>
<!-- Reference configuration: copy to ci/maven-settings.xml in each consuming repository.
     observation-protos is illustrative; replace it with the actual library repository.
     Credentials come from the environment and are never committed here. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0">
  <servers>
    <server>
      <!-- Must match the repository ID below and distributionManagement in the library POM. -->
      <id>github</id>
      <username>${env.MAVEN_USERNAME}</username>
      <password>${env.MAVEN_TOKEN}</password>
    </server>
  </servers>

  <profiles>
    <profile>
      <id>github-packages</id>
      <repositories>
        <repository>
          <id>github</id>
          <!-- This is the repository publishing the library, including in application builds. -->
          <url>https://maven.pkg.github.com/nggong/observation-protos</url>
          <releases>
            <enabled>true</enabled>
          </releases>
          <snapshots>
            <enabled>true</enabled>
          </snapshots>
        </repository>
      </repositories>
    </profile>
  </profiles>

  <activeProfiles>
    <activeProfile>github-packages</activeProfile>
  </activeProfiles>
</settings>
